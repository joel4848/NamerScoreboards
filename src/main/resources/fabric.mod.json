{
  "schemaVersion": 1,
  "id": "nicknames-everywhere",
  "version": "${version}",
  "name": "Nicknames Everywhere",
  "description": "Formattable nicknames that display everywhere I could think of",
  "authors": [
    "joel4848"
  ],
  "contact": {},

  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/nicknameseverywhere/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.joel4848.nicknameseverywhere.NicknamesEverywhere"
    ],
    "client": [
      "com.joel4848.nicknameseverywhere.NicknamesEverywhereClient"
    ],
    "cardinal-components": [
      "com.joel4848.nicknameseverywhere.registry.CardinalComponentsRegistry"
    ]
  },

  "mixins": [
    "nicknameseverywhere.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": ">=${minecraft_version}",
    "owo": "*"
  },

  "custom": {
    "cardinal-components": [
      "nicknameseverywhere:storage"
    ]
  }
}